# ========================================================
# Aithyrion Director - Environment Configuration Template
# ========================================================
# Copy this file to .env and fill in your actual credentials.
# Note: Secrets are kept server-side only and never exposed to the client bundle.

# 1. TypeSafe AI (JEV SystemOne) Engine
# Endpoint URL for official SystemOne Director API
JEV_API_ENDPOINT=https://api.typesafe.ai/v1/systemone
# Bearer token API Key
JEV_API_KEY=your_typesafe_jev_api_key_here

# 2. MiniMax Hailuo Video Engine
# MiniMax Video Generation API Key (sk-...)
MINIMAX_API_KEY=your_minimax_api_key_here
# MiniMax API Host (default: api.minimaxi.chat)
MINIMAX_API_HOST=api.minimaxi.chat

# 3. OpenAI Codex CLI (Optional - for local character keyframe generation)
# Path to local codex binary if not in PATH (e.g. C:\Users\<User>\AppData\Local\OpenAI\Codex\bin\...\codex.exe)
# CODEX_PATH=

# 4. Standalone Server Port (Optional - default: 5174)
API_PORT=5174
